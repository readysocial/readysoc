# Base URL for the Ready Social backend API (no trailing slash)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5005

# Setup:
#   cp .env.example .env.local    # local dev (backend runs on :5005)
# On Vercel: set NEXT_PUBLIC_API_BASE_URL in Project Settings →
# Environment Variables for all environments, then redeploy.
# NOTE: NEXT_PUBLIC_* vars are baked in at `next build` time — changing the
# value requires a rebuild/redeploy, and a dev server restart locally.

# Note: Paystack web returns to FRONTEND_URL/spark-bundle/result on the API.
# For local checkout testing, set backend FRONTEND_URL to this Next app origin
# (e.g. http://localhost:3000 or http://localhost:3003).
